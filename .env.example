# -----------------------------------------------------------------------------
# Brazza Hotel — local configuration
# Copy this file to .env and adapt the values for your machine.
# NEVER commit .env to Git.
# -----------------------------------------------------------------------------

APP_NAME="Brazza Hotel"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Brazzaville
APP_LOCALE=fr

# MySQL 8 / MariaDB 10.4+
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=brazza_hotel
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Session hardening. Set SESSION_SECURE=true only when the site is served over HTTPS.
SESSION_NAME=brazza_hotel_session
SESSION_LIFETIME=7200
SESSION_SECURE=false

# Uploads
UPLOAD_MAX_BYTES=4194304

# Official hotel details — leave blank until confirmed by the hotel.
# The interface will display "À confirmer" instead of inventing information.
HOTEL_PHONE=
HOTEL_WHATSAPP=
HOTEL_EMAIL=
HOTEL_ADDRESS=
HOTEL_MAPS_QUERY=Brazzaville, République du Congo

# Contact form delivery is stored in MySQL. This address is reserved for a future
# notification integration and is never displayed publicly unless configured.
MAIL_TO=
